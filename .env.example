EVALUAI_APP_NAME=EvaluAI API
EVALUAI_APP_DESCRIPTION=API to evaluate training impact with AI
EVALUAI_APP_VERSION=0.1.0
EVALUAI_API_PREFIX=/api/v1
EVALUAI_ALLOWED_ORIGINS=*
EVALUAI_SURVEYS_PATH=data/raw/EIPIA_FO_dataset_100_personas.csv
EVALUAI_COURSES_PATH=data/courses.csv
EVALUAI_MENTORS_PATH=data/mentors.csv
EVALUAI_CHAT_PROVIDER=rule_based
EVALUAI_AZURE_FOUNDRY_ENDPOINT=
EVALUAI_AZURE_FOUNDRY_API_KEY=
EVALUAI_AZURE_FOUNDRY_MODEL=
EVALUAI_AZURE_FOUNDRY_TEMPERATURE=0.2
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Vite dev-server proxy target for /api/* requests.
# Leave unset (default: http://backend:8000) inside docker-compose.
# Uncomment and set to http://localhost:8000 when running Vite outside docker-compose.
# BACKEND_PROXY_TARGET=http://localhost:8000

# ==================== ML CONFIG ====================
# Data path for ML notebooks (input dataset)
DATA_PATH=backend/data/raw/EIPIA_FO_dataset_100_personas.csv
# Output directory for engineered survey dataset
ENGINEERED_DATA_DIR=backend/data/processed
# Model path for ML notebooks (output trained models)
MODEL_PATH=backend/ml/models

# ==================== SUPABASE CONFIG ====================
# Required for Docker backend
# Use REST API URL (https://...), NOT PostgreSQL connection string
SUPABASE_URL=
SUPABASE_KEY=
#SUPABASE_URL=postgresql://postgres.zeoafuemimbvaubaelen:cB6reuDVm3EzJzPG@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# ==================== GEMINI API CONFIG ====================
# For docker-compose (backend expects this variable)
GEMINI_API_KEY=

# ==================== CHATBOT CORE CONFIG ====================
# Gemini Model Configuration (for chatbot core direct use)
CHATBOT_GEMINI_API_KEY=
CHATBOT_GEMINI_MODEL=gemini-2.5-flash
CHATBOT_GEMINI_TEMPERATURE=0.4
CHATBOT_GEMINI_MAX_TOKENS=800
CHATBOT_GEMINI_TIMEOUT_SECONDS=30
CHATBOT_GEMINI_MAX_RETRIES=3

# Conversation Memory
CHATBOT_CONVERSATION_MAX_TURNS=10
CHATBOT_CONVERSATION_MAX_TURNS_TO_API=8

# Goal Detection Keywords (comma-separated)
CHATBOT_GOAL_DETECTION_KEYWORDS=learn,improve,develop,advance,study,train,certification,master,become

# Logging
CHATBOT_LOG_LEVEL=INFO
CHATBOT_DEBUG_MODE=false

# Browser uses localhost:9000 (mapped port), not backend:8000 (internal Docker)
VITE_API_BASE_URL=http://localhost:9000/api/v1
